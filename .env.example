# ======================================================================
# SANTARA.ID ENVIRONMENT CONFIGURATION
# ======================================================================

# 1. SUPABASE (PostgreSQL Database & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. BANK BRI OPEN BANKING (BRIAPI Sandbox / Production)
# Portal: https://developer.bri.co.id
BRIAPI_BASE_URL=https://sandbox.partner.api.bri.co.id
BRIAPI_CLIENT_ID=your-briapi-client-id
BRIAPI_CLIENT_SECRET=your-briapi-client-secret
BRIAPI_MERCHANT_ID=000000000000001
BRIAPI_PARTNER_SERVICE_ID=90123

# 3. GOOGLE GEMINI AI (Santara AI Analytics & Restock Predictor)
# Portal: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# 4. WHATSAPP GATEWAY (Fonnte / Wablas untuk OTP & Notifikasi Pasar)
WHATSAPP_API_TOKEN=your-whatsapp-gateway-token
WHATSAPP_API_URL=https://api.fonnte.com/send

# 5. APP HOST
NEXT_PUBLIC_APP_URL=http://localhost:3000
